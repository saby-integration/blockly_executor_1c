
// Функция ПереложитьФайлСоСбисДиска
//
// Параметры:
//  context_params - Структура - Параметры подключения
//  Файл - Структура - Параметры файла из вложения
//
// Возвращаемое значение:
//  - Структура - Параметры файла с обновленной ссылкой
//
//DynamicDirective
Функция ПереложитьФайлСоСбисДиска(context_params, Файл)
	Если get_prop(Файл, "Ссылка") <> Неопределено Тогда
		ДД = ТранспортИнтеграции.local_helper_download_from_link(context_params, get_prop(Файл, "Ссылка"));
		Base64 = Base64Строка(ДД);
		СсылкаНаPDF = ТранспортИнтеграции.local_helper_convert_to_pdfa_to_disk_x(context_params, Base64, Файл["Имя"]); 
		Файл.Вставить("Ссылка", get_prop(СсылкаНаPDF, "FileId"));
	КонецЕсли;
	Возврат Файл;
КонецФункции

